{
  "name": "candy-chase",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build && node scripts/copy-game-runtime.mjs",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "vitest",
    "test:run": "vitest run",
    "test:game": "node --test rhythm-game/tests/*.test.js rhythm-game/attack-event-contract.test.js",
    "test:runtime": "node --test scripts/copy-game-runtime.test.mjs",
    "verify:assets": "node scripts/verify-assets.mjs"
  },
  "dependencies": {
    "@fontsource/montserrat": "^5.3.0",
    "phaser": "^4.2.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^30.1.1",
    "playwright-core": "^1.63.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
